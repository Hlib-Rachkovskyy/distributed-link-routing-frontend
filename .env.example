# =========================================================================
# LinkShrink URL Shortener Frontend Configuration Template
# =========================================================================

# 🌐 API BASE URL
# -------------------------------------------------------------------------
# Set this to your production backend API gateway (e.g., https://api.yourdomain.com).
# Leave this blank or comment it out in development to use Vite's local 
# development server proxy configuration which forwards '/api' to 'http://localhost:8080'.
VITE_API_BASE_URL=

# 🔌 WEB SERVER PORT
# -------------------------------------------------------------------------
# The port number on which the local Vite development server should listen.
# Default is '5173' if not specified.
PORT=5173
